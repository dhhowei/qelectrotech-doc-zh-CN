msgstr "移动列表"

#: ../../source/users/reports/summary/edit_summary.rst:102
msgid "Remove field from display list"
msgstr "从显示列表中删除字段"

#: ../../source/users/reports/summary/edit_summary.rst:102
msgid "Double click on field at display list"
msgstr "在显示列表中双击字段"

#: ../../source/users/reports/summary/edit_summary.rst:103
msgid "|go-down|"
msgstr "|go-down|"

#: ../../source/users/reports/summary/edit_summary.rst:119
