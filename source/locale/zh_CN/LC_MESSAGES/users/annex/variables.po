msgstr "**% {author}**: 图幅作者"

#: ../../source/users/annex/variables.rst:45
msgid "**% {date}**: Folio date"
msgstr "**% {date}**: 图幅日期"

#: ../../source/users/annex/variables.rst:46
msgid "**% {folio}**: Folio information (Label)"
msgstr "**% {folio}**: 图幅信息（标签）"

#: ../../source/users/annex/variables.rst:47
msgid "**% {indexrev}**: Folio revision index"
msgstr "**% {indexrev}**: 图幅修订索引"

#: ../../source/users/annex/variables.rst:48
