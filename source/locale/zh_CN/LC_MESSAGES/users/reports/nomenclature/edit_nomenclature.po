#: ../../source/users/reports/nomenclature/edit_nomenclature.rst:101
msgid "Remove field from display list"
msgstr "从显示列表中删除字段"

#: ../../source/users/reports/nomenclature/edit_nomenclature.rst:101
msgid "Double click on field at display list"
msgstr "双击显示列表中的字段"

#: ../../source/users/reports/nomenclature/edit_nomenclature.rst:102
msgid "|go-down|"
msgstr "|go-down|"

