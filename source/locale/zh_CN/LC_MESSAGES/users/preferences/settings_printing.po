#: ../../source/users/preferences/settings_printing.rst:5
msgid "Printing settings"
msgstr "打印设置"

#: ../../source/users/preferences/settings_printing.rst:7
msgid ""
"QElectroTech allows predefining printing settings for reducing the working "
"configuration effort each time that a `project`_ have to be printed."
msgstr "QElectroTech 允许预先定义打印设置，以减少每次必须打印 `项目 <project_>`_ 时的配置工作。"

#: ../../source/users/preferences/settings_printing.rst:10
msgid "The default exporting settings which can be chosen are:"
msgstr "可以选择的默认导出设置包括："

#: ../../source/users/preferences/settings_printing.rst:12
msgid "Default rendering options:"
msgstr "默认渲染选项："

#: ../../source/users/preferences/settings_printing.rst:13
msgid "Draw or not borders."
msgstr "是否绘制边框。"

#: ../../source/users/preferences/settings_printing.rst:14
msgid "Title block."
msgstr "图框。"

#: ../../source/users/preferences/settings_printing.rst:15
msgid "Draw grid."
msgstr "绘制网格。"

#: ../../source/users/preferences/settings_printing.rst:16
msgid "Draw terminals."
msgstr "绘制端子。"

#: ../../source/users/preferences/settings_printing.rst:17
msgid "Keep conductor colors or monochrome."
msgstr "保留导体颜色或使用单色。"

#: ../../source/users/preferences/settings_printing.rst:19
msgid "To define default printing settings:"
msgstr "要定义默认打印设置："

#: ../../source/users/preferences/settings_printing.rst:21
msgid "`Display`_ QElectroTech settings PopUP window."
msgstr "`显示 <Display_>`_ QElectroTech 设置弹出窗口。"

#: ../../source/users/preferences/settings_printing.rst:22
msgid "Go to **Printing** section."
msgstr "转到 **打印** 部分。"

#: ../../source/users/preferences/settings_printing.rst:23
msgid "Select the desired setting values for each field."
msgstr "为每个字段选择所需的设置值。"

#: ../../source/users/preferences/settings_printing.rst:24
msgid "Press **OK** button to save the configuration changes."
msgstr "按 **OK** 按钮保存配置更改。"

#: ../../source/users/preferences/settings_printing.rst:29
msgid "Figure: QElectroTech printing settings"
msgstr "图：QElectroTech 打印设置"

#: ../../source/users/preferences/settings_printing.rst:33
msgid ""
"For more information about QElectroTech printing options, refer to "
"`printing`_ section."
msgstr "有关 QElectroTech 打印选项的更多信息，请参阅 `打印 <printing_>`_ 部分。"
